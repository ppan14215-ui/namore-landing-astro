---
/**
 * SwipeDeck — the app's core mechanic, live on the name page.
 *
 * Why (2026-11-23, SEO audit): Google sends ~1.3K sessions/28d to /names/*
 * but only 1.4% clicked a store button with the static ConsensusCta. People
 * arrive wanting "what does X mean", not "install an app". Instead of asking
 * them to read a pitch, this hands them the thing itself: a small stack of
 * name cards (this name + its related names) they can drag left/right, with
 * tilt, LIKE/NOPE stamps, depth and haptics. The first ♥ flips into the
 * private-overlap pitch ("now see if your partner picks it too") with the
 * store button for their OS and the names they just saved.
 *
 * No-JS / crawler view: the cards render as a plain list and the store
 * buttons are always in the HTML, so nothing is hidden from Google.
 *
 * Events (PostHog, via window.posthog from analytics.js):
 *   name_deck_swipe  {direction, card_name, position, page_name}
 *   name_deck_reveal {liked_count, liked_names, page_name, trigger}
 * Store clicks keep the canonical app_store_click / google_play_click /
 * store_click events via data-cta-location="name_page_deck".
 */
import type { NameRow } from '@/lib/types';
import photos from '@/data/fyp-photos.json';

interface Props {
  name: NameRow;
  related: NameRow[];
  lang?: 'en' | 'de';
  /** Overrides the headline name (list pages use the list title). */
  heading?: string;
  placement?: string;
}
const { name, related, lang = 'en', heading, placement = 'name_page_deck' } = Astro.props as Props;
const de = lang === 'de';
const L = de
  ? {
      eyebrow: 'Probiert es aus wie in der App', keep: 'Würdest du', keepQ: 'behalten?', sub: 'Karte ziehen: rechts behalten, links weg.',
      stampKeep: 'Behalten', stampSkip: 'Weg', meaningOf: 'Bedeutung von', savedEyebrow: 'Nur auf diesem Handy gemerkt',
      revealA: 'Und jetzt: würde dein Partner', revealB: 'auch behalten?',
      revealCopy: 'In Namore swipt ihr beide auf euren eigenen Handys. Eure Listen bleiben privat. Ihr seht nur die Namen, die ihr <strong>beide</strong> behalten habt.',
      ios: 'Zusammen swipen auf dem iPhone', android: 'Zusammen swipen auf Android', more: 'Hier weiterswipen',
      note: 'Kostenlos starten · keine Werbung · kein Konto nötig', namesN: (n: number) => `${n} Namen`,
      pass: 'Weiter', love: 'Behalten', skipAria: 'Namen überspringen', keepAria: 'Namen behalten', iosNs: 'Für iPhone laden', androidNs: 'Für Android laden',
    }
  : {
      eyebrow: 'Try it like in the app', keep: 'Would you keep', keepQ: '?', sub: 'Drag the card: right to keep, left to skip.',
      stampKeep: 'Keep', stampSkip: 'Skip', meaningOf: 'Meaning of', savedEyebrow: 'Saved on this phone only',
      revealA: 'Now: would your partner keep', revealB: 'too?',
      revealCopy: 'In Namore you both swipe on your own phones. Your lists stay private. You only see the names you <strong>both</strong> kept.',
      ios: 'Swipe together on iPhone', android: 'Swipe together on Android', more: 'Keep swiping here',
      note: 'Free to start · no ads · no account needed', namesN: (n: number) => `${n} names`,
      pass: 'Pass', love: 'Love it', skipAria: 'Skip this name', keepAria: 'Keep this name', iosNs: 'Get for iPhone', androidNs: 'Get for Android',
    };

const cards = [name, ...related].slice(0, 6);
const gender = (g: NameRow['gender']) =>
  de ? (g === 'M' ? 'Junge' : g === 'F' ? 'Mädchen' : 'Unisex') : g === 'M' ? 'Boy' : g === 'F' ? 'Girl' : 'Unisex';
const originOf = (c: NameRow) => (de ? c.origin_de || c.origin : c.origin);
const meaningOf = (c: NameRow) => (de ? c.meaning_short_de || c.meaning_short : c.meaning_short);
const vibes = (s: string | null) =>
  (s ?? '')
    .split(/[,;|]/)
    .map((t) => t.trim().toLowerCase())
    .filter(Boolean)
    .slice(0, 3);

// Photos (2026-11-23, Julian: "the look of the For You page, with the emotional
// images"): the same R2 pool the app's For You feed uses, limited to the
// emotional / parents / maternity families. Stable per name (FNV-1a, like the
// app's backdropIndexFor), gender-matched (n = no visible child, fits all),
// and never twice in one deck.
type Photo = { id: string; g: 'm' | 'f' | 'n'; f: string };
const POOL = photos.images as Photo[];
const FAMILY_CYCLE = ['emotional', 'parents', 'maternity', 'parents', 'emotional', 'maternity'];
const fnv = (str: string) => {
  let h = 0x811c9dc5;
  const k = str.trim().toLocaleLowerCase();
  for (let i = 0; i < k.length; i++) { h ^= k.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
  return h;
};
const usedPhotos = new Set<string>();
const photoFor = (c: NameRow, slot: number) => {
  const g = c.gender === 'M' ? 'm' : c.gender === 'F' ? 'f' : null;
  const fam = FAMILY_CYCLE[(fnv(name.name) + slot) % FAMILY_CYCLE.length];
  for (const f of [fam, ...FAMILY_CYCLE.filter((x) => x !== fam)]) {
    const list = POOL.filter((p) => p.f === f && (p.g === 'n' || p.g === g));
    if (!list.length) continue;
    let i = fnv(c.name) % list.length;
    for (let t = 0; t < list.length && usedPhotos.has(list[i].id); t++) i = (i + 1) % list.length;
    if (usedPhotos.has(list[i].id)) continue;
    usedPhotos.add(list[i].id);
    return `${photos.base}/${list[i].id}`;
  }
  return null;
};
const cardPhotos = cards.map((c, i) => photoFor(c, i));

const content = encodeURIComponent((de ? 'de_' : 'deck_') + (heading ? placement : name.name));
const appStoreUrl =
  'https://apps.apple.com/app/id6766572995?utm_source=names_page&utm_medium=organic&utm_campaign=swipe_deck&utm_content=' +
  content;
const googlePlayUrl =
  'https://play.google.com/store/apps/details?id=com.julian.namore&utm_source=names_page&utm_medium=organic&utm_campaign=swipe_deck&utm_content=' +
  content;
---

<section class="deck" data-deck data-page-name={heading ?? name.name} data-names-label={L.namesN(0).replace('0 ', '')} aria-label={`Swipe ${name.name}`}>
  <header class="deck-head">
    <p class="deck-eyebrow">{L.eyebrow}</p>
    {heading
      ? <h2>{L.keep} <em>{heading}</em> {L.keepQ}</h2>
      : <h2>{L.keep} <em>{name.name}</em>{de ? ' ' : ''}{L.keepQ}</h2>}
    <p class="deck-sub">{L.sub}</p>
  </header>

  <div class="phone">
  <div class="phone-screen">
  <div class="phone-status" aria-hidden="true">
    <span class="ps-time">9:41</span>
    <span class="ps-island"></span>
    <span class="ps-icons">
      <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
      <svg viewBox="0 0 26 12"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".45"/><rect x="2.5" y="2.5" width="16" height="7" rx="2"/><rect x="24" y="4" width="1.6" height="4" rx=".8" opacity=".45"/></svg>
    </span>
  </div>
  <div class="phone-appbar" aria-hidden="true">
    <span class="pa-tab is-on">{de ? 'Für dich' : 'For You'}</span>
    <span class="pa-tab">{de ? 'Matches' : 'Matches'}</span>
  </div>
  <div class="deck-stage" data-stage>
    <span class="deck-count" data-count aria-live="polite"></span>
    <ol class="deck-stack" data-stack>
      {cards.map((c, i) => (
        <li
          class="dcard"
          data-card
          data-name={c.name}
          style={`--i:${i}`}
          aria-label={`${c.name}, ${gender(c.gender)}${originOf(c) ? ', ' + originOf(c) : ''}`}
        >
          <span class="stamp stamp-like" aria-hidden="true">{L.stampKeep}</span>
          <span class="stamp stamp-nope" aria-hidden="true">{L.stampSkip}</span>
          {cardPhotos[i] && (
            <img class="dcard-photo" src={cardPhotos[i]} alt="" width="720" height="1280" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" onerror="this.remove()" />
          )}
          <span class="dcard-shade" aria-hidden="true"></span>
          <div class="dcard-copy">
            <p class="dcard-chip">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg>
              {gender(c.gender)}{originOf(c) ? ` · ${originOf(c)}` : ''}
            </p>
            <p class="dcard-name">{c.name}</p>
            {meaningOf(c) && <p class="dcard-meaning">{de ? '„' : '\u201C'}{meaningOf(c)}{de ? '“' : '\u201D'}</p>}
            {(c.pronunciation_text || vibes(c.vibe_tags).length > 0) && (
              <p class="dcard-meta">
                {[c.pronunciation_text, ...vibes(c.vibe_tags)].filter(Boolean).map((m, k) => <>{k > 0 && <i class="dot" />}<span>{m}</span></>)}
              </p>
            )}
          {(i > 0 || heading) && (
            <a class="dcard-link" href={`/names/${c.name.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`}>
              {L.meaningOf} {c.name} →
            </a>
          )}
          </div>
        </li>
      ))}
    </ol>

    <div class="deck-reveal" data-reveal hidden>
      <p class="deck-eyebrow">{L.savedEyebrow}</p>
      <h3>
        {L.revealA} <em data-reveal-names>{name.name}</em> {L.revealB}
      </h3>
      <p class="reveal-copy" set:html={L.revealCopy} />
      <ul class="reveal-chips" data-chips aria-label="Names you kept"></ul>
      <div class="reveal-actions">
        <a class="btn btn-ink btn-lg store-ios" href={appStoreUrl} data-cta-location={placement} data-cta-message="swipe_deck">{L.ios}</a>
        <a class="btn btn-ink btn-lg store-android" href={googlePlayUrl} data-cta-location={placement} data-cta-message="swipe_deck">{L.android}</a>
      </div>
      <button type="button" class="reveal-more" data-more>{L.more}</button>
      <p class="reveal-note">{L.note}</p>
    </div>
  </div>

  <div class="deck-controls" data-controls>
    <button type="button" class="pill pill-pass" data-act="nope" aria-label={L.skipAria}>{L.pass}</button>
    <button type="button" class="pill pill-love" data-act="like" aria-label={L.keepAria}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg>
      {L.love}
    </button>
  </div>
  <span class="phone-home" aria-hidden="true"></span>
  </div>
  </div>

  <noscript>
    <div class="reveal-actions">
      <a class="btn btn-ink btn-lg" href={appStoreUrl}>{L.iosNs}</a>
      <a class="btn btn-ink btn-lg" href={googlePlayUrl}>{L.androidNs}</a>
    </div>
  </noscript>
</section>

<style>
  .deck {
    max-width: 640px;
    margin: -24px auto 56px;
    padding: 26px clamp(16px, 4vw, 28px) 24px;
    border-radius: 26px;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(201, 120, 92, 0.13), transparent 60%),
      var(--bg-deep);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .deck-head { text-align: center; margin-bottom: 18px; }
  .deck-eyebrow {
    margin: 0 0 6px;
    color: var(--terra-deep);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .deck h2, .deck h3 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .deck h2 { font-size: clamp(1.7rem, 5vw, 2.3rem); }
  .deck h3 { font-size: clamp(1.45rem, 4.4vw, 1.9rem); }
  .deck h2 em, .deck h3 em { color: var(--terra-deep); font-weight: 500; }
  .deck-sub { margin: 6px 0 0; color: var(--ink-3); font-size: 0.9rem; }

  /* Stage: fixed height so flying cards never reflow the page */
  /* Phone mockup: the deck lives inside an iPhone so it reads as the app */
  .phone {
    position: relative;
    width: min(330px, 84vw);
    margin: 4px auto 0;
    padding: 11px;
    border-radius: 54px;
    background: linear-gradient(145deg, #3a332d, #15120f 55%, #2b2520);
    box-shadow:
      0 0 0 1.5px #5a5048 inset,
      0 0 0 3px #0d0b09 inset,
      0 40px 80px rgba(40, 24, 16, 0.32),
      0 12px 26px rgba(40, 24, 16, 0.2);
  }
  .phone::before, .phone::after {
    content: '';
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: #2b2520;
  }
  .phone::before { left: -3px; top: 120px; height: 56px; }
  .phone::after { right: -3px; top: 150px; height: 80px; }
  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 19.2;
    border-radius: 44px;
    overflow: hidden;
    background: var(--paper);
    isolation: isolate;
  }
  .phone-status {
    flex: none;
    position: relative;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 26px 0 30px;
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14px;
  }
  .ps-island {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 96px;
    height: 28px;
    margin-left: -48px;
    border-radius: 16px;
    background: #0d0b09;
  }
  .ps-icons { display: inline-flex; gap: 5px; align-items: center; }
  .ps-icons svg { height: 11px; width: auto; fill: currentColor; }
  .phone-appbar {
    flex: none;
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 2px 20px 8px;
    font-family: var(--serif);
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink-3);
  }
  .pa-tab.is-on { color: var(--ink); }
  .pa-tab:not(.is-on) { font-size: 15px; }
  .phone-home {
    flex: none;
    display: block;
    width: 112px;
    height: 4px;
    margin: 6px auto 8px;
    border-radius: 3px;
    background: var(--ink);
    opacity: 0.85;
  }
  .deck-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 0 10px;
    perspective: 1200px;
  }
  .deck-stack { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
  /* Card = the app's For You page (FeedCard B2): full-bleed photo, ink
     gradient from the bottom, glass reason chip, Fraunces name in paper,
     italic meaning, mono meta with rose dots. */
  .dcard {
    position: absolute;
    inset: 0 0 12px;
    border-radius: 26px;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 10px 24px rgba(40, 24, 16, 0.22);
    transform-origin: 50% 50%;
    transform: scale(calc(1 - min(var(--depth, var(--i)), 2) * 0.04));
    z-index: calc(10 - var(--i));
    transition: transform 0.38s cubic-bezier(0.2, 0.9, 0.25, 1.15), opacity 0.3s ease, box-shadow 0.3s ease;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    will-change: transform;
  }
  .dcard:nth-child(n + 4) { opacity: 0; }
  .deck.is-live .dcard:nth-child(n + 2) { pointer-events: none; }
  .deck.is-live .dcard.is-top { pointer-events: auto; }
  .dcard.is-dragging { transition: none; cursor: grabbing; box-shadow: 0 34px 70px rgba(40, 24, 16, 0.36); }
  .dcard.is-gone { pointer-events: none; }
  .dcard-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transform: scale(1.04);
    transition: transform 0.6s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  .dcard.is-top .dcard-photo { transform: scale(1); }
  .dcard-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(42, 38, 34, 0.25) 0%, rgba(42, 38, 34, 0) 26%, rgba(42, 38, 34, 0) 44%, rgba(42, 38, 34, 0.86) 100%);
  }
  .dcard-copy {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
  }
  .dcard-chip {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 14px;
    padding: 5px 10px;
    border-radius: 14px;
    background: rgba(255, 250, 243, 0.16);
    border: 1px solid rgba(255, 250, 243, 0.3);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .dcard-chip svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; }
  .dcard-name {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(46px, 13vw, 68px);
    line-height: 0.98;
    letter-spacing: -2.4px;
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dcard-meaning {
    margin: 10px 0 0;
    max-width: 300px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.3;
    color: rgba(255, 250, 243, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .dcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    font-family: var(--mono);
    font-size: 11px;
    color: rgba(255, 250, 243, 0.82);
  }
  .dcard-meta .dot { width: 4px; height: 4px; border-radius: 2px; background: var(--rose, #E4A79A); }
  .dcard-link {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: rgba(255, 250, 243, 0.9);
    align-self: flex-start;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .stamp {
    position: absolute;
    top: 26px;
    z-index: 2;
    padding: 4px 12px;
    border: 3px solid currentColor;
    border-radius: 10px;
    font-family: var(--sans);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: rgba(42, 38, 34, 0.25);
    opacity: 0;
    pointer-events: none;
  }
  .stamp-like { left: 20px; color: #9FE0A9; transform: rotate(-12deg); opacity: var(--like, 0); }
  .stamp-nope { right: 20px; color: #FFD8CC; transform: rotate(12deg); opacity: var(--nope, 0); }
  .deck-count {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 30;
    height: 28px;
    padding: 0 11px;
    border-radius: 14px;
    background: rgba(42, 38, 34, 0.62);
    color: rgba(255, 250, 243, 0.85);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 28px;
    letter-spacing: 0.5px;
    pointer-events: none;
  }
  .deck-count:empty { display: none; }

  /* Rail: the app's Pass / Love pills */
  .deck-controls {
    flex: none;
    display: flex;
    gap: 10px;
    padding: 0 12px;
  }
  .pill {
    height: 48px;
    border-radius: 24px;
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 15px;
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.2s;
  }
  .pill:active, .pill.pulse { transform: scale(0.95); }
  .pill-pass { flex: 1; background: var(--paper); color: var(--ink); border: 1px solid var(--line); }
  .pill-love { flex: 1.4; background: var(--terra); color: var(--paper); box-shadow: 0 10px 22px rgba(201, 120, 92, 0.3); }
  .pill-love svg { width: 17px; height: 17px; fill: var(--paper); }

  /* Reveal */
  .deck-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    padding: 6px 8px;
    background: var(--paper);
    z-index: 40;
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.1);
  }
  .deck-reveal[hidden] { display: none; }
  .deck-reveal.is-on { opacity: 1; transform: none; }
  .reveal-copy { margin: 10px auto 0; max-width: 46ch; color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; }
  .reveal-chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 12px 0 0; padding: 0; }
  .reveal-chips :global(li) {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 15px;
  }
  .reveal-chips :global(li)::before { content: '♥ '; color: var(--terra); }
  .reveal-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 16px; }
  .reveal-more {
    margin: 10px auto 0;
    background: none;
    border: 0;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
  }
  .reveal-note { margin: 6px 0 0; color: var(--ink-3); font-family: var(--mono); font-size: 0.68rem; }
  .deck.is-revealed .deck-stack,
  .deck.is-revealed .deck-controls { visibility: hidden; }
  .deck-reveal h3 { font-size: 1.45rem; }
  .deck-reveal .reveal-copy { font-size: 0.85rem; }
  .deck-reveal .reveal-actions { flex-direction: column; align-items: stretch; gap: 8px; }
  .deck-reveal .reveal-actions .btn { justify-content: center; }
  .deck.is-revealed .deck-count { display: none; }

  /* Only show the store button for the visitor's OS (desktop sees both) */
  :global(html.os-ios) .deck .store-android,
  :global(html.os-android) .deck .store-ios { display: none; }

  /* No-JS / pre-hydration: plain readable list, no stage */
  .deck:not(.is-live) .phone { width: auto; padding: 0; background: none; box-shadow: none; border-radius: 0; }
  .deck:not(.is-live) .phone::before, .deck:not(.is-live) .phone::after,
  .deck:not(.is-live) .phone-status, .deck:not(.is-live) .phone-appbar, .deck:not(.is-live) .phone-home { display: none; }
  .deck:not(.is-live) .phone-screen { aspect-ratio: auto; overflow: visible; border-radius: 0; background: none; }
  .deck:not(.is-live) .deck-stage { height: auto; margin: 0; }
  .deck:not(.is-live) .deck-stack { position: static; display: grid; gap: 10px; }
  .deck:not(.is-live) .dcard { position: relative; inset: auto; transform: none; opacity: 1; cursor: default; height: 360px; }
  .deck:not(.is-live) .deck-count { display: none; }
  .deck:not(.is-live) .stamp,
  .deck:not(.is-live) .deck-controls { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .dcard, .dcard-photo, .deck-reveal, .pill { transition-duration: 0.01ms !important; }
  }
</style>

<script>
  type PH = { capture?: (e: string, p?: Record<string, unknown>) => void };
  const THRESHOLD = 90;

  function track(event: string, props: Record<string, unknown>) {
    const ph = (window as unknown as { posthog?: PH }).posthog;
    try { ph?.capture?.(event, props); } catch { /* analytics must never break the deck */ }
  }
  function buzz(ms: number) {
    try { (navigator as Navigator & { vibrate?: (p: number) => boolean }).vibrate?.(ms); } catch { /* iOS Safari has no vibrate */ }
  }

  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const pageName = deck.dataset.pageName || '';
    const cards = Array.from(deck.querySelectorAll<HTMLElement>('[data-card]'));
    const reveal = deck.querySelector<HTMLElement>('[data-reveal]')!;
    const chips = deck.querySelector<HTMLElement>('[data-chips]')!;
    const revealNames = deck.querySelector<HTMLElement>('[data-reveal-names]')!;
    const count = deck.querySelector<HTMLElement>('[data-count]')!;
    const btnLike = deck.querySelector<HTMLElement>('[data-act="like"]')!;
    const btnNope = deck.querySelector<HTMLElement>('[data-act="nope"]')!;
    let idx = 0;
    const liked: string[] = [];
    let revealedOnce = false;

    deck.classList.add('is-live');
    // Keep links inside cards from starting drags.
    deck.querySelectorAll('.dcard-link').forEach((a) => a.addEventListener('pointerdown', (e) => e.stopPropagation()));

    function layout() {
      cards.forEach((c, i) => {
        const d = i - idx;
        c.classList.toggle('is-top', d === 0);
        if (d < 0) return;
        c.style.setProperty('--depth', String(Math.min(d, 2)));
        c.style.zIndex = String(20 - d);
        c.style.opacity = d > 2 ? '0' : '1';
        if (!c.classList.contains('is-dragging')) c.style.transform = '';
      });
      const left = cards.length - idx;
      count.textContent = left > 0 ? `${idx + 1} / ${cards.length}` : '';
    }

    function showReveal(trigger: string) {
      if (liked.length === 0) {
        revealNames.textContent = pageName;
      } else {
        revealNames.textContent = liked.length === 1 ? liked[0] : `${liked.length} ${deck.dataset.namesLabel || 'names'}`;
      }
      chips.innerHTML = '';
      liked.forEach((n) => {
        const li = document.createElement('li');
        li.textContent = n;
        chips.appendChild(li);
      });
      const more = deck.querySelector<HTMLElement>('[data-more]');
      if (more) more.hidden = idx >= cards.length;
      reveal.hidden = false;
      deck.classList.add('is-revealed');
      requestAnimationFrame(() => reveal.classList.add('is-on'));
      track('name_deck_reveal', { liked_count: liked.length, liked_names: liked.slice(0, 6), page_name: pageName, trigger });
    }
    function hideReveal() {
      reveal.classList.remove('is-on');
      deck.classList.remove('is-revealed');
      reveal.hidden = true;
    }

    function commit(dir: 'like' | 'nope', viaButton: boolean) {
      const card = cards[idx];
      if (!card) return;
      const out = dir === 'like' ? 1 : -1;
      card.classList.remove('is-dragging');
      card.classList.add('is-gone');
      card.style.setProperty('--like', dir === 'like' ? '1' : '0');
      card.style.setProperty('--nope', dir === 'nope' ? '1' : '0');
      card.style.transition = 'transform 0.45s cubic-bezier(0.3, 0.6, 0.3, 1), opacity 0.45s ease';
      card.style.transform = `translate3d(${out * 140}%, -30px, 0) rotate(${out * 24}deg)`;
      card.style.opacity = '0';
      buzz(dir === 'like' ? 18 : 8);
      const btn = dir === 'like' ? btnLike : btnNope;
      btn.classList.add('pulse');
      setTimeout(() => btn.classList.remove('pulse'), 180);
      const name = card.dataset.name || '';
      if (dir === 'like') liked.push(name);
      track('name_deck_swipe', { direction: dir, card_name: name, position: idx, page_name: pageName, via: viaButton ? 'button' : 'drag' });
      idx += 1;
      layout();
      const done = idx >= cards.length;
      if ((dir === 'like' && !revealedOnce) || done) {
        revealedOnce = true;
        setTimeout(() => showReveal(done ? 'deck_end' : 'first_like'), 360);
      }
    }

    // Drag physics on the top card. Move/up are tracked on window so a mouse
    // release anywhere (outside the card, outside the deck) always drops it.
    let startX = 0, startY = 0, dx = 0, dy = 0, dragging = false, crossed = false, pid = -1;
    deck.addEventListener('dragstart', (e) => e.preventDefault());
    deck.addEventListener('pointerdown', (e) => {
      const card = cards[idx];
      if (!card || !(e.target instanceof Node) || !card.contains(e.target)) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      if (e.pointerType === 'mouse') e.preventDefault(); // no text selection / native drag
      dragging = true; crossed = false; pid = e.pointerId;
      startX = e.clientX; startY = e.clientY; dx = dy = 0;
      card.classList.add('is-dragging');
    });
    const move = (e: PointerEvent) => {
      if (!dragging || e.pointerId !== pid) return;
      if (e.pointerType === 'mouse' && e.buttons === 0) { end(e); return; }
      const card = cards[idx];
      dx = e.clientX - startX;
      dy = e.clientY - startY;
      const rot = dx / 18;
      card.style.transform = `translate3d(${dx}px, ${dy * 0.25}px, 0) rotate(${rot}deg)`;
      const p = Math.min(1, Math.abs(dx) / THRESHOLD);
      card.style.setProperty('--like', dx > 0 ? String(p) : '0');
      card.style.setProperty('--nope', dx < 0 ? String(p) : '0');
      const next = cards[idx + 1];
      if (next) next.style.transform = `scale(${0.96 + 0.04 * p})`;
      if (!crossed && Math.abs(dx) > THRESHOLD) { crossed = true; buzz(6); }
      if (crossed && Math.abs(dx) < THRESHOLD) crossed = false;
    };
    function end(e: PointerEvent | { pointerId: number }) {
      if (!dragging || e.pointerId !== pid) return;
      dragging = false;
      const card = cards[idx];
      if (!card) return;
      if (Math.abs(dx) > THRESHOLD) {
        commit(dx > 0 ? 'like' : 'nope', false);
      } else {
        card.classList.remove('is-dragging');
        card.style.setProperty('--like', '0');
        card.style.setProperty('--nope', '0');
        card.style.transform = '';
        layout();
      }
    }
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
    window.addEventListener('blur', () => end({ pointerId: pid }));

    btnLike.addEventListener('click', () => commit('like', true));
    btnNope.addEventListener('click', () => commit('nope', true));
    deck.addEventListener('keydown', (e) => {
      if (deck.classList.contains('is-revealed')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); commit('like', true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); commit('nope', true); }
    });
    deck.querySelector('[data-more]')?.addEventListener('click', () => {
      if (idx >= cards.length) return; // nothing left; keep the pitch up
      hideReveal();
      track('name_deck_keep_swiping', { page_name: pageName, liked_count: liked.length });
    });

    layout();
  });
</script>

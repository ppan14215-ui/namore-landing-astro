---
/**
 * ClusterFoot — "Weiterlesen" block + sources note for the German cluster.
 *
 * ⚠️ REBUILT 2026-08-19 on Julian's feedback: the first version dumped six
 * sibling links in one line separated by "·", jammed against the sources
 * paragraph. It read as SEO plumbing, not navigation. Now each link carries a
 * one-line reason to click, under its own heading, with the sources note
 * visually demoted below it.
 *
 * The hub-and-spoke wiring is the point: URL Inspection on 2026-08-16 reported
 * "Referring page: None detected" for the hub. Orphaned pages on a domain with
 * a crawl-budget problem do not get fetched.
 */
import { VERIFIED } from '../data/apps-de';

export interface Props {
  /** Slug of the current page, so it is not linked to itself. */
  current: string;
}
const { current } = Astro.props;

const links: { href: string; label: string; blurb: string }[] = [
  {
    href: '/de/blog/beste-babynamen-apps',
    label: 'Babynamen-Apps 2026 im Vergleich',
    blurb: 'Fünf Apps nebeneinander, jeweils mit ihren eigenen Angaben.',
  },
  {
    href: '/de/blog/babynamen-app-fuer-paare',
    label: 'Babynamen-App für Paare',
    blurb: 'Worauf es ankommt, wenn ihr zu zweit entscheidet.',
  },
  {
    href: '/de/blog/babynamen-app-wie-tinder',
    label: 'Babynamen-App wie Tinder',
    blurb: 'Wischen zu zweit — und was nach dem Match kommt.',
  },
  {
    href: '/de/blog/babynamen-app-kostenlos',
    label: 'Was „kostenlos“ wirklich heißt',
    blurb: 'Werbung, Tageslimits, Abo oder Einmalkauf — alle Preismodelle.',
  },
  {
    href: '/de/blog/beste-vornamen-app',
    label: 'Beste Vornamen-App',
    blurb: 'Die vier Punkte, in denen sich die Apps wirklich unterscheiden.',
  },
  {
    href: '/de/blog/babynamen-app-abstimmen',
    label: 'Babynamen gemeinsam abstimmen',
    blurb: 'Wie das Matching funktioniert — und woran es danach hakt.',
  },
  {
    href: '/de/blog/namensfinder-app',
    label: 'Namensfinder-App',
    blurb: 'Was die Vorschläge steuert und was hinter den KI-Versprechen steckt.',
  },
  {
    href: '/de/blog/babyname-passend-zum-nachnamen',
    label: 'Passend zum Nachnamen',
    blurb: 'Rhythmus, Endlaute, Initialen: fünf Prüfungen zum Lautlesen.',
  },
  {
    href: '/de/blog/namore-vs-charliesnames',
    label: 'Namore und CharliesNames',
    blurb: 'Über 15.000 Namen aus über 40 Ländern, werbefrei.',
  },
  {
    href: '/de/blog/namore-vs-kinder',
    label: 'Namore und Kinder',
    blurb: 'Namens-Sets einzeln kaufbar, Käufe gelten für beide.',
  },
  {
    href: '/de/blog/namore-vs-unser-baby-name',
    label: 'Namore und Unser Baby Name',
    blurb: 'Mehr als 30.000 Namen, Kopplung über verbundene Accounts.',
  },
  {
    href: '/de/blog/namore-vs-mini-marvin',
    label: 'Namore und Mini Marvin',
    blurb: 'Läuft im Browser, keine Installation nötig.',
  },
];

const rest = links.filter((l) => !l.href.endsWith(current));
---

<footer class="post-foot">
  <h2 class="foot-head">Weiterlesen</h2>
  <ul class="cluster-links">
    {rest.map((l) => (
      <li>
        <a href={l.href}>{l.label}</a>
        <span>{l.blurb}</span>
      </li>
    ))}
    <li>
      <a href="/names">Vornamen durchstöbern</a>
      <span>15.182 Namen mit Bedeutung, Herkunft und Aussprache.</span>
    </li>
  </ul>

  <p class="sources-note">
    <strong>Quellen und Methode.</strong> Grundlage sind die öffentlich einsehbaren Einträge im
    deutschen App Store und bei Google Play sowie die Seiten der Anbieter, geprüft am {VERIFIED}.
    Wo eine Angabe dort nicht steht, steht hier „Keine Angabe im Store-Eintrag“ — das heißt,
    wir haben dazu nichts gefunden, nicht, dass die App es nicht kann. Funktionen und Preise ändern sich; schaut vor dem
    Download in den aktuellen Eintrag.
  </p>
</footer>

---
/**
 * ClusterFoot — shared sources + internal-link block for the German cluster.
 *
 * The link list is the hub-and-spoke wiring. Every spoke links to the hub and
 * to its siblings; the hub links down. This exists because URL Inspection on
 * 2026-08-16 reported "Referring page: None detected" for the hub — orphaned
 * pages on a domain with a crawl-budget problem do not get fetched.
 */
import { VERIFIED } from '../data/apps-de';

export interface Props {
  /** Slug of the current page, so it is not linked to itself. */
  current: string;
}
const { current } = Astro.props;

const links: [string, string][] = [
  ['/de/blog/beste-babynamen-apps', 'Alle Babynamen-Apps im Vergleich'],
  ['/de/blog/babynamen-app-fuer-paare', 'Babynamen-App für Paare'],
  ['/de/blog/babynamen-app-kostenlos', 'Babynamen-Apps kostenlos'],
  ['/de/blog/namore-vs-charliesnames', 'Namore vs. CharliesNames'],
  ['/de/blog/namore-vs-kinder', 'Namore vs. Kinder'],
  ['/de/blog/namore-vs-unser-baby-name', 'Namore vs. Unser Baby Name'],
  ['/de/blog/namore-vs-mini-marvin', 'Namore vs. Mini Marvin'],
];
---

<footer class="post-foot">
  <p>
    Quellen: die öffentlich einsehbaren Einträge im deutschen App Store und bei Google Play sowie
    die Seiten der Anbieter, geprüft am {VERIFIED}. Wo eine Angabe dort nicht steht, steht hier
    „nicht belegt“ — das heißt, wir haben es nicht gefunden, nicht, dass die App es nicht kann.
    Funktionen und Preise ändern sich; schaut vor dem Download in den aktuellen Eintrag.
  </p>
  <p class="more-to-read">
    {links
      .filter(([href]) => !href.endsWith(current))
      .map(([href, label], i) => (
        <>{i > 0 ? ' · ' : ''}<a href={href}>{label}</a></>
      ))}
     · <a href="/names">Vornamen durchstöbern</a>
  </p>
</footer>

---
/**
 * VsTable — head-to-head fact table: criteria as rows, Namore and one
 * competitor side by side. Rewritten 2026-08-21; the first version of this
 * file predated the evidence rule and read fields (platform, doubleBlind)
 * that were removed when the cluster was rebuilt on literal transcriptions.
 *
 * Evidence rule: the competitor column is ONLY literal transcriptions from
 * apps-de.ts (multi-line entries are separate lines from the same source,
 * joined with ·), or "Keine Angabe". The Namore column is our own
 * description, from namore-cells.ts, and the footnote says so. No row may
 * editorialise ("besser", "einzige", a checkmark/cross scheme) — a tick
 * grid is a characterisation, not a quotation.
 */
import { NO_STATEMENT, VERIFIED, type App, type Sourced } from '../data/apps-de';
import { NAMORE_DE, LABELS_DE, type CellKey } from '../data/namore-cells';

export interface Props {
  rival: App;
  rows?: CellKey[];
}
const { rival, rows = ['partner', 'account', 'price', 'ads', 'names', 'ai'] } = Astro.props;

const lines = (v: NonNullable<Sourced>) =>
  [v.q, v.q2, v.q3, v.q4, v.q5].filter(Boolean) as string[];

const isWeb = !rival.rating && rival.src.includes('mini-marvin');
const noneLabel = isWeb ? 'Keine Angabe auf der Anbieterseite' : NO_STATEMENT;
const anyCompiled = rows.some((r) => rival[r]?.compiled);
---

<div class="table-wrap">
  <table class="cmp cmp-vs">
    <thead>
      <tr>
        <th></th>
        <th>Namore</th>
        <th><a href={rival.src} rel="nofollow noopener" target="_blank">{rival.name}</a></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{LABELS_DE[r]}</th>
          <td data-label="Namore">{NAMORE_DE[r]}</td>
          <td data-label={rival.name}>
            {rival[r] ? (
              <>
                {lines(rival[r]!).map((l, i) => <>{i > 0 ? ' · ' : ''}<q>{l}</q></>)}
                  {rival[r]!.note ? <span class="sf-note"> ({rival[r]!.note})</span> : null}
                {rival[r]!.src !== rival.src ? <> <a class="sf-src" href={rival[r]!.src} rel="nofollow noopener" target="_blank">Quelle</a></> : null}
              </>
            ) : (
              <span class="sf-none">{noneLabel}</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="post-caveat">
  Die Namore-Spalte ist unsere eigene Beschreibung. Die Spalte zu {rival.name} ist wörtlich
  {isWeb ? ' von der Anbieterseite' : ' aus dem Eintrag im deutschen App Store'} übernommen, abgerufen am
  {VERIFIED}.{anyCompiled
    ? ' Steht in einer Zelle mehr als eine Angabe, sind das einzelne Zeilen aus derselben Quelle, von uns nebeneinandergestellt.'
    : ''} Der vollständige Wortlaut steht unten auf dieser Seite.
</p>

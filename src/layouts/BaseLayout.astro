---
/**
 * BaseLayout — shared chrome for every programmatic SEO page.
 *
 * Owns:
 *   - Full <head>: title, meta description, canonical, OG, Twitter, JSON-LD slot
 *   - Brand stylesheet + font preconnect (matches namore-landing)
 *   - Top nav with logo + "Get the app" CTA
 *   - Footer with NAMORE.APP wordmark
 *
 * Per-page surfaces (title, description, OG image, JSON-LD) are passed in
 * as props so each name page can render its own meta block without
 * duplicating the chrome.
 */

/*
 * Fonts are SELF-HOSTED. Do not reintroduce fonts.googleapis.com or
 * fonts.gstatic.com here or anywhere else in this project.
 *
 * Loading them from Google's servers transmits the visitor's IP address to
 * Google without consent. LG München I, 20.01.2022 – 3 O 17493/20 awarded
 * damages for exactly that and set off a mass-Abmahnung wave. These pages
 * additionally tell readers "keine Weitergabe von Daten", so the old setup
 * paired the exposure with a contradicting claim. Changed 2026-08-19.
 *
 * Licences (SIL OFL 1.1) ship inside each package; keep the packages rather
 * than copying loose .woff2 files around.
 */
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Raw JSON-LD object to embed as a <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown>;
  /**
   * Document language. Defaults to 'en'. The German cluster under /de/ MUST
   * pass 'de' — Google reads <html lang> as a localisation signal, and until
   * 2026-08-17 every German page here shipped as lang="en".
   */
  lang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://www.namore.app/og-card.png',
  ogImageAlt = 'Namore — find a name you both love. The private baby name app for couples.',
  jsonLd,
  lang = 'en',
} = Astro.props;

const appStoreUrl = 'https://apps.apple.com/app/id6766572995?utm_source=names_nav&utm_medium=organic&utm_campaign=programmatic_seo';
const googlePlayUrl = 'https://play.google.com/store/apps/details?id=com.julian.namore&utm_source=names_nav&utm_medium=organic&utm_campaign=programmatic_seo';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="https://www.namore.app/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://www.namore.app/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://www.namore.app/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://www.namore.app/apple-touch-icon.png" />
    <meta name="theme-color" content="#F5EFE6" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    {/* Open Graph */}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Namore" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* App Store smart banner — keeps the install funnel one tap away */}
    <meta name="apple-itunes-app" content="app-id=6766572995" />

    {/* Fonts — same preconnect + Google Fonts URL as the marketing site */}

    {/* JSON-LD structured data (per-page) */}
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    {/* PostHog analytics — same script that runs on namore.app/. Served
        from the namore-landing project at /analytics.js so name pages
        and the landing site report to one PostHog project (key
        phc_yK5hjiKAj644…). Captures $pageview automatically; the
        `apps.apple.com/app/id6766572995` click handler in analytics.js
        fires `app_store_click` with the page URL embedded, so the name
        slug is recoverable from $pathname in PostHog. UTM params on the
        outgoing App Store URL flow into the event properties too.

        `defer` so it doesn't block the initial HTML render — the script
        ships small, but per-name pages are SEO surfaces where TTFB and
        LCP matter. */}
    <script src="/analytics.js" defer></script>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a class="brand" href="https://www.namore.app/">
          <img src="https://www.namore.app/logo.png" alt="Namore" width="28" height="28" />
          namore
        </a>
        <div class="nav-cta">
          <a class="btn btn-ghost" href="https://www.namore.app/">Home</a>
          <a class="btn btn-ghost store-nav" href={appStoreUrl}>iPhone</a>
          <a class="btn btn-ink store-nav" href={googlePlayUrl}>Android</a>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="site-footer">
      <span>NAMORE.APP</span>
      {/*
        Internal links to the comparison articles. Added 2026-08-16 after Search
        Console URL Inspection reported "Referring page: None detected" for both
        blog URLs — nothing on the site linked to them, so they had no internal
        PageRank at all. Sitewide footer placement is deliberate: it gives the
        articles a link from every page in the ~15K /names corpus, which is the
        largest internal signal available on this domain.
      */}
      <span>
        <a href="/blog/best-baby-name-apps">Best baby name apps</a> ·
        <a href="/de/blog/beste-babynamen-apps">Beste Babynamen-Apps</a>
      </span>
      <span><a href={appStoreUrl}>App Store</a> · <a href={googlePlayUrl}>Google Play</a></span>
      {/*
        ⚠️ IMPRESSUM + DATENSCHUTZ ARE LEGALLY REQUIRED ON EVERY PAGE, NOT OPTIONAL.
        §5 DDG (ex §5 TMG) requires the provider identification to be "leicht
        erkennbar, unmittelbar erreichbar und ständig verfügbar" from every page
        of a commercial site. Until 2026-08-19 this footer had neither, which
        meant roughly 7,900 indexed /names/* pages plus the blog were reachable
        with no Impressum link anywhere on them — while namore.app's own root
        footer had both. A missing Impressum is the single most frequently
        abgemahnte defect on German websites. Do not remove these two links.
      */}
      <span>
        <a href="/impressum.html">Impressum</a> ·
        <a href="/privacy.html">Datenschutz</a> ·
        <a href="/terms.html">AGB</a> · © 2026 Namore
      </span>
    </footer>
  </body>
</html>

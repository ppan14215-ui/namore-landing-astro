---
/**
 * namore-vs-unser-baby-name — rebuilt 2026-08-19 under the post-review evidence rule.
 *
 * Competitor content on this page is ONLY literal transcriptions from the
 * store listing, rendered by <StoreFacts> with a source link and a date.
 * This page's own prose says nothing factual about the competitor that is
 * not in that block. Do not add characterisation, superlatives, or claims
 * about what a competitor does internally — see the header of apps-de.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Disclosure from '../../../components/Disclosure.astro';
import StoreFacts from '../../../components/StoreFacts.astro';
import WhyNamore from '../../../components/WhyNamore.astro';
import ClusterFoot from '../../../components/ClusterFoot.astro';
import { byslug, VERIFIED, APP_STORE, PLAY } from '../../../data/apps-de';

const rival = byslug('unser-baby-name');
const canonical = 'https://www.namore.app/de/blog/namore-vs-unser-baby-name';
const campaign = 'vs_unser_baby_name';

const faqs = [
  {
    q: 'Was unterscheidet Namore von Unser Baby Name?',
    a: 'Unser Baby Name nennt im deutschen App Store mehr als 30.000 Vornamen und setzt voraus, dass beide Elternteile die App installieren und ihre Accounts verbinden. Namore hat 15.182 Namen, braucht kein Konto — ein Code aus sechs Buchstaben genügt — zeigt keine Werbung und hat nach dem Match eine Endrunde, in der beide die gemeinsamen Treffer noch einmal getrennt bewerten.',
  },
  {
    q: 'Sind Unser Baby Name und Baby Name Together dieselbe App?',
    a: 'Ja. Es ist ein Produkt desselben Anbieters mit identischer App-ID in beiden Stores; die deutsche und die englische Website gehören zum selben Angebot. Vergleichslisten, die beide als getrennte Apps führen, zählen dieselbe App doppelt.',
  },
  {
    q: 'Was kostet Unser Baby Name?',
    a: 'Der deutsche App-Store-Eintrag weist die In-App-Käufe „Full Version 8,99 €“ und „Unlock all features 1,99 €“ aus; auf der Website des Anbieters stehen abweichende Preise. Bei Namore schaltet ein einmaliger Kauf von 7,99 € unbegrenztes Wischen und alle Filter für beide Handys frei, ohne Abo.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'Namore und Unser Baby Name im Vergleich',
      description: 'Namore und Unser Baby Name nebeneinander: was im Store-Eintrag steht, was Namore macht, und wofür welche App die passendere ist.',
      inLanguage: 'de-DE',
      datePublished: '2026-08-19',
      dateModified: '2026-08-19',
      author: { '@type': 'Person', name: 'Julian Ziegler' },
      publisher: {
        '@type': 'Organization',
        name: 'Namore',
        logo: { '@type': 'ImageObject', url: 'https://www.namore.app/logo@2x.png' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    },
    {
      '@type': 'FAQPage',
      inLanguage: 'de-DE',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  lang="de"
  title='Namore und Unser Baby Name im Vergleich | Namore'
  description='Namore und Kinder nebeneinander: was im Store-Eintrag von Kinder steht, was Namore macht, und wofür welche App die passendere ist.'
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="post" lang="de">
    <Disclosure />

    <header class="post-head">
      <p class="post-kicker">App-Vergleich · Abgerufen am {VERIFIED}</p>
      <h1>Namore und Unser Baby Name</h1>
    </header>

    <p class="post-standfirst">
      Unser Baby Name hat die größere Datenbank und ist deutlich länger am Markt — international
      läuft dieselbe App unter dem Namen „Baby Name Together“, mit derselben App-ID. Namore ist
      kleiner und auf die Entscheidung zu zweit gebaut. Unten steht zuerst, was der Eintrag im
      deutschen App Store sagt.
    </p>

    <StoreFacts app={rival} />

    <h2>Wofür Unser Baby Name die bessere Wahl sein kann</h2>
    <p>
      Bei der Größe. Der Eintrag nennt mehr als 30.000 Vornamen aller Herkunft — deutlich mehr als
      unsere 15.182 — und die App ist seit Jahren am Markt. Wenn euch eine große, lange erprobte
      Namenssammlung wichtiger ist als alles andere, ist das ein gutes Argument.
    </p>
    <p>
      Ein Punkt aus dem Eintrag ist für die Einrichtung relevant: „Beide Elternteile installieren
      die App und verbinden ihre Accounts.“ Bei Namore gibt es kein Konto — einer öffnet eine
      Sitzung, der andere tritt mit einem Code aus sechs Buchstaben bei.
    </p>
    <p class="post-caveat">
      Zur Einordnung, weil es in Vergleichslisten oft falsch steht: <strong>Unser Baby Name und
      Baby Name Together sind dieselbe App</strong> desselben Anbieters, mit identischer App-ID in
      beiden Stores. Es sind nicht zwei Produkte.
    </p>
    <WhyNamore lang="de" heading='Was Namore macht' only={['decision-round', 'no-account', 'no-ads', 'learning', 'no-repeats', 'privacy-price']} />

    <p class="cta-row">
      <a class="btn btn-ink" href={APP_STORE(campaign)}>Namore für iOS laden</a>
      <a class="btn btn-ghost" href={PLAY(campaign)}>Bei Google Play laden</a>
    </p>

    <h2>Häufige Fragen</h2>
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>

    <ClusterFoot current="namore-vs-unser-baby-name" />
  </article>
</BaseLayout>

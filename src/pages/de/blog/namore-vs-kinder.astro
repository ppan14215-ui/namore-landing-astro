---
/**
 * namore-vs-kinder — rebuilt 2026-08-19 under the post-review evidence rule.
 *
 * Competitor content on this page is ONLY literal transcriptions from the
 * store listing, rendered by <StoreFacts> with a source link and a date.
 * This page's own prose says nothing factual about the competitor that is
 * not in that block. Do not add characterisation, superlatives, or claims
 * about what a competitor does internally — see the header of apps-de.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Disclosure from '../../../components/Disclosure.astro';
import StoreFacts from '../../../components/StoreFacts.astro';
import WhyNamore from '../../../components/WhyNamore.astro';
import ClusterFoot from '../../../components/ClusterFoot.astro';
import { byslug, VERIFIED, APP_STORE, PLAY } from '../../../data/apps-de';

const rival = byslug('kinder');
const canonical = 'https://www.namore.app/de/blog/namore-vs-kinder';
const campaign = 'vs_kinder';

const faqs = [
  {
    q: 'Was unterscheidet Namore von Kinder?',
    a: 'Kinder verkauft laut App Store einzelne Namens-Sets ab 0,99 €, alle zusammen für 5,99 €, wobei Käufe zwischen verbundenen Partnern geteilt werden; der Eintrag weist die App als werbehaltig aus und bietet einen Login per E-Mail an. Namore zeigt keine Werbung, braucht kein Konto — ein Code aus sechs Buchstaben genügt — und hat nach dem Match eine Endrunde, in der ihr die gemeinsamen Treffer getrennt bewertet.',
  },
  {
    q: 'Welche App ist günstiger?',
    a: 'Das hängt davon ab, wie viel ihr braucht. Ein einzelnes Sprach-Set bei Kinder kostet 0,99 €, alle zusammen 5,99 €. Namore ist kostenlos mit 100 Swipes pro Person je 24 Stunden ohne Werbung; unbegrenztes Wischen und alle Filter kosten einen einmaligen Kauf und gelten für beide Handys (im deutschen Store derzeit 7,99 €, je Land unterschiedlich).',
  },
  {
    q: 'Gibt es eine Babynamen-App zum Wischen?',
    a: 'Mehrere. Kinder, BabyName, Unser Baby Name, Mini Marvin und Namore arbeiten alle mit Wischen. Der Unterschied liegt darin, was danach passiert: Bei Namore erscheint ein Name erst, wenn ihr beide unabhängig voneinander Ja gesagt habt, und im Anschluss bringt eine Endrunde die gemeinsamen Treffer in eine Reihenfolge.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'Namore und Kinder im Vergleich',
      description: 'Namore und Kinder nebeneinander: was im Store-Eintrag von Kinder steht, was Namore macht, und wofür welche App die passendere ist.',
      inLanguage: 'de-DE',
      datePublished: '2026-08-19',
      dateModified: '2026-08-19',
      author: { '@type': 'Person', name: 'Julian Ziegler' },
      publisher: {
        '@type': 'Organization',
        name: 'Namore',
        logo: { '@type': 'ImageObject', url: 'https://www.namore.app/logo@2x.png' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    },
    {
      '@type': 'FAQPage',
      inLanguage: 'de-DE',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  lang="de"
  title='Namore und Kinder im Vergleich | Namore'
  description='Namore und Kinder nebeneinander: was im Store-Eintrag von Kinder steht, was Namore macht, und wofür welche App die passendere ist.'
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="post" lang="de">
    <Disclosure />

    <header class="post-head">
      <p class="post-kicker">App-Vergleich · Abgerufen am {VERIFIED}</p>
      <h1>Namore und Kinder</h1>
    </header>

    <p class="post-standfirst">
      Kinder verkauft Namens-Sets einzeln statt im Abo und ist mit 381 Bewertungen im deutschen App
      Store länger im Einsatz als Namore. Namore ist neuer und auf die Entscheidung zu zweit gebaut.
      Unten steht zuerst, was Kinder über sich selbst sagt — wörtlich und verlinkt.
    </p>

    <StoreFacts app={rival} />

    <h2>Wofür Kinder die bessere Wahl sein kann</h2>
    <p>
      Das Preismodell ist ungewöhnlich fair: Der Eintrag weist einzelne Sprach-Sets zu je 0,99 € aus
      und alle zusammen für 5,99 €, und er hält ausdrücklich fest, dass Käufe geteilt werden, wenn
      ihr verbunden seid. Wer nur ein Set braucht, kommt für unter einem Euro aus. Mit 20.000+
      Namen nennt Kinder außerdem mehr Namen als Namore.
    </p>
    <p>
      Zwei Dinge stehen ebenfalls im Eintrag und sind für eure Entscheidung relevant: Die App
      enthält Werbung, und ihr könnt ein Konto anlegen beziehungsweise euch per E-Mail anmelden.
      Bei Namore gibt es beides nicht.
    </p>

    <WhyNamore lang="de" heading='Was Namore macht' only={['decision-round', 'no-ads', 'no-account', 'name-depth', 'learning', 'no-repeats']} />

    <p class="cta-row">
      <a class="btn btn-ink" href={APP_STORE(campaign)}>Namore für iOS laden</a>
      <a class="btn btn-ghost" href={PLAY(campaign)}>Bei Google Play laden</a>
    </p>

    <h2>Häufige Fragen</h2>
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>

    <ClusterFoot current="namore-vs-kinder" />
  </article>
</BaseLayout>

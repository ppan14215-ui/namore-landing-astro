---
/**
 * namore-vs-mini-marvin — rebuilt 2026-08-19 under the post-review evidence rule.
 *
 * Competitor content on this page is ONLY literal transcriptions from the
 * store listing, rendered by <StoreFacts> with a source link and a date.
 * This page's own prose says nothing factual about the competitor that is
 * not in that block. Do not add characterisation, superlatives, or claims
 * about what a competitor does internally — see the header of apps-de.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Disclosure from '../../../components/Disclosure.astro';
import StoreFacts from '../../../components/StoreFacts.astro';
import WhyNamore from '../../../components/WhyNamore.astro';
import ClusterFoot from '../../../components/ClusterFoot.astro';
import { byslug, VERIFIED, APP_STORE, PLAY } from '../../../data/apps-de';

const rival = byslug('mini-marvin');
const canonical = 'https://www.namore.app/de/blog/namore-vs-mini-marvin';
const campaign = 'vs_mini_marvin';

const faqs = [
  {
    q: 'Was unterscheidet Namore von Mini Marvin?',
    a: 'Mini Marvin läuft im Browser, verlangt eine kostenlose Registrierung und erlaubt im Gratistarif 500 Swipes am Tag mit Werbung und einem eingeladenen Partner. Namore ist eine App für iPhone und Android, braucht kein Konto, zeigt keine Werbung und erlaubt 100 Swipes pro Person je 24 Stunden. Nach dem Match hat Namore eine Endrunde, die aus den gemeinsamen Treffern eine Reihenfolge macht.',
  },
  {
    q: 'Was kostet Mini Marvin?',
    a: 'Laut Preisseite: kostenlos mit Werbung und 500 Swipes am Tag, „Für Paare“ 6,99 € einmalig für drei Monate, „Familie & Freunde“ 12,99 € einmalig, laut Preisseite lebenslang und mit der Angabe „Familie & Freunde einladen“. Namore kostet einmalig 7,99 € für beide Handys, ohne Abo.',
  },
  {
    q: 'Brauche ich eine App oder reicht der Browser?',
    a: 'Für Mini Marvin reicht der Browser, es muss nichts installiert werden — das ist der Vorteil, wenn ihr keine App wollt. Namore gibt es nur als App für iPhone und Android, dafür ohne Registrierung und ohne Werbung.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'Namore und Mini Marvin im Vergleich',
      description: 'Namore und Mini Marvin nebeneinander: was Mini Marvin über sich sagt, was Namore macht, und wofür welche Lösung die passendere ist.',
      inLanguage: 'de-DE',
      datePublished: '2026-08-19',
      dateModified: '2026-08-19',
      author: { '@type': 'Person', name: 'Julian Ziegler' },
      publisher: {
        '@type': 'Organization',
        name: 'Namore',
        logo: { '@type': 'ImageObject', url: 'https://www.namore.app/logo@2x.png' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    },
    {
      '@type': 'FAQPage',
      inLanguage: 'de-DE',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout
  lang="de"
  title='Namore und Mini Marvin im Vergleich | Namore'
  description='Namore und Kinder nebeneinander: was im Store-Eintrag von Kinder steht, was Namore macht, und wofür welche App die passendere ist.'
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="post" lang="de">
    <Disclosure />

    <header class="post-head">
      <p class="post-kicker">App-Vergleich · Abgerufen am {VERIFIED}</p>
      <h1>Namore und Mini Marvin</h1>
    </header>

    <p class="post-standfirst">
      Mini Marvin kommt aus Dresden und läuft komplett im Browser — es muss nichts installiert
      werden. Namore gibt es nur als App für iPhone und Android. Unten steht zuerst, was Mini
      Marvin über sich selbst sagt, wörtlich und verlinkt.
    </p>

    <StoreFacts app={rival} />

    <h2>Wofür Mini Marvin die bessere Wahl sein kann</h2>
    <p>
      Wenn einer von euch keine weitere App auf dem Handy will, ist das der ganze Vorteil in einem
      Satz — Mini Marvin läuft im Browser. Der kostenlose Tarif erlaubt außerdem 500 Swipes am Tag,
      also deutlich mehr als unsere 100 pro Person je 24 Stunden; dafür ist er laut Preisseite mit
      Werbung und auf einen eingeladenen Partner begrenzt.
    </p>
    <p>
      Und wenn ihr Großeltern oder Freunde mit abstimmen lassen wollt: Dafür führt die Preisseite den Tarif
      „Familie &amp; Freunde“ für 12,99 € einmalig. Namore ist bewusst auf zwei Personen ausgelegt
      und kann das nicht.
    </p>
    <WhyNamore lang="de" heading='Was Namore macht' only={['decision-round', 'no-ads', 'no-account', 'name-depth', 'no-repeats', 'privacy-price']} />

    <p class="cta-row">
      <a class="btn btn-ink" href={APP_STORE(campaign)}>Namore für iOS laden</a>
      <a class="btn btn-ghost" href={PLAY(campaign)}>Bei Google Play laden</a>
    </p>

    <h2>Häufige Fragen</h2>
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>

    <ClusterFoot current="namore-vs-mini-marvin" />
  </article>
</BaseLayout>

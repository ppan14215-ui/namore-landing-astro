---
/**
 * /names/[slug] — one static HTML page per name in the Supabase `names`
 * table. 15K+ pages total (English-only v1).
 *
 * Build flow:
 *   1. `getStaticPaths()` reads every name from Supabase via the service
 *      role key (or the mock fixture when USE_MOCK_DATA=1).
 *   2. Each row produces a slug + props bundle (the row itself + the 5
 *      related names for internal linking).
 *   3. The template renders the brand chrome, the NameCardHero visual,
 *      the longevity + trend-context narrative, the related-names block,
 *      and the install CTA.
 *
 * Why all the data crunching lives in getStaticPaths instead of the page
 * body: Astro calls getStaticPaths ONCE at build time and reuses the
 * result for all pages. Doing related-name computation per page in the
 * template would mean O(N × N) work; doing it once with shared state is
 * O(N).
 */

import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NameCardHero from '@/components/NameCardHero.astro';
import type { NameRow } from '@/lib/types';
import { nameToSlug } from '@/lib/types';
import { getAllNames, findRelatedNames } from '@/lib/names';
import { originSlug, nameInitial } from '@/lib/hubs';

export const getStaticPaths = (async () => {
  const all = await getAllNames();
  console.log(`[build] generating ${all.length} name pages`);

  return all.map((row) => ({
    params: { slug: nameToSlug(row.name) },
    props: {
      row,
      related: findRelatedNames(row, all, 5),
    },
  }));
}) satisfies GetStaticPaths;

interface PageProps {
  row: NameRow;
  related: NameRow[];
}
const { row, related } = Astro.props as PageProps;

const slug = nameToSlug(row.name);
const canonical = `https://www.namore.app/names/${slug}`;

// "Up" links to the hub pages — gives each name page a path back to the
// browse hubs so the internal-link graph is bidirectional (hubs link down,
// names link up). This is what turns thousands of orphan pages into a crawlable set.
const initial = nameInitial(row.name);
const hasLetterHub = /[A-Z]/.test(initial);

// Install CTA URL — tagged with UTMs so when the click event fires in
// PostHog (via analytics.js's click handler on apps.apple.com/app/id…
// links), the params land in the event properties and we can attribute
// install funnel traffic back to the specific name page that drove it.
//
// Apple strips most params before the install actually completes (iOS
// privacy rules), but the click event in PostHog happens BEFORE the
// user leaves the page, so the attribution is captured there. The
// post-install user is then a separate anonymous person; correlation
// uses timing + region heuristics, not deterministic linking.
const appStoreUrl = `https://apps.apple.com/app/id6766572995?utm_source=names_page&utm_medium=organic&utm_campaign=programmatic_seo&utm_content=${slug}`;

// SEO title — head term + qualifier. Pattern: "Theodora — meaning, origin
// and popularity". Stays under Google's ~55-60 char SERP truncation for
// most names.
const title = `${row.name} — meaning, origin and popularity`;

// Meta description — short, factual, includes the meaning + origin.
// Pattern: "<Name>: <meaning>. A <origin> name with <vibe>. See
// pronunciation, nicknames, and popularity over time on Namore."
const descParts: string[] = [];
descParts.push(`${row.name}:`);
if (row.meaning_short) descParts.push(`${row.meaning_short.toLowerCase()}.`);
if (row.origin) {
  const article = /^[aeiou]/i.test(row.origin) ? 'an' : 'a';
  descParts.push(`${article} ${row.origin} name${row.gender === 'F' ? ' for girls' : row.gender === 'M' ? ' for boys' : ''}.`);
}
descParts.push('Pronunciation, nicknames, popularity over time.');
const description = descParts.join(' ').slice(0, 160);

// JSON-LD: a schema.org @graph combining a BreadcrumbList (rich-result
// eligible — Google renders the Home > Baby Names > <Name> trail in the SERP)
// with a DefinedTerm describing the name as a glossary entry. BaseLayout
// JSON.stringify()s whatever object it's handed, so a @graph slots in cleanly.
// (Fixes an earlier bug where inLanguage was set to the ORIGIN, e.g.
// "Germanic", which is not a language code — origin now rides on termCode.)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.namore.app/' },
        { '@type': 'ListItem', position: 2, name: 'Baby Names', item: 'https://www.namore.app/names' },
        { '@type': 'ListItem', position: 3, name: row.name, item: canonical },
      ],
    },
    {
      '@type': 'DefinedTerm',
      name: row.name,
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        name: 'Namore baby names',
        url: 'https://www.namore.app/names',
      },
      description: row.meaning || row.meaning_short || `${row.name} — a ${row.origin ?? ''} name.`.trim(),
      inLanguage: 'en',
      ...(row.origin ? { termCode: row.origin } : {}),
      url: canonical,
    },
  ],
};

// Format helpers for the narrative sections.
function describePopularity(name: NameRow): string | null {
  if (!Array.isArray(name.popularity_history) || name.popularity_history.length < 2) {
    return null;
  }
  const first = name.popularity_history[0];
  const last = name.popularity_history[name.popularity_history.length - 1];
  if (last > first * 1.5) {
    return `${name.name}'s popularity has grown sharply over the past five decades — from a relative score of ${first} in the 1970s to ${last} in the most recent decade tracked.`;
  }
  if (last < first * 0.7) {
    return `${name.name} has been on a long arc of decline — peaking around the ${name.peak_decade ?? 'mid-century'} and tapering to a relative score of ${last} in recent years.`;
  }
  return `${name.name} has held a steady cultural position across the decades, with relative popularity scores ranging from ${Math.min(...name.popularity_history)} to ${Math.max(...name.popularity_history)} since the 1970s.`;
}

const popularityNarrative = describePopularity(row);

// "Related names" intro varies by what they share with the target row.
function describeRelation(target: NameRow, related: NameRow[]): string {
  if (related.length === 0) return '';
  const sameOrigin = related.every((r) => r.origin === target.origin && target.origin);
  if (sameOrigin) {
    return `Other ${target.origin} names with similar texture:`;
  }
  return `Names that share ${target.name}'s vibe and feel:`;
}
const relatedIntro = describeRelation(row, related);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <main class="wrap page">
    <p class="page-eyebrow">Baby name</p>

    <NameCardHero name={row} />

    <aside class="geo-cta" aria-label={`Decide on ${row.name} with Namore`}>
      <p class="geo-line">
        Use <strong>Namore</strong> to find out if you and your partner both
        secretly love <strong>{row.name}</strong> — both of you swipe privately
        and only mutual matches are revealed.
      </p>
      <a class="geo-store" href={appStoreUrl}>Download Namore on the App Store →</a>
    </aside>

    {row.longevity_read && (
      <section class="narrative" aria-label={`Longevity reading for ${row.name}`}>
        <h2>How it <em>ages</em>.</h2>
        <p>{row.longevity_read}</p>
      </section>
    )}

    {row.trend_context && (
      <section class="narrative" aria-label={`Trend context for ${row.name}`}>
        <h2>The <em>cultural moment</em>.</h2>
        <p>{row.trend_context}</p>
      </section>
    )}

    {popularityNarrative && (
      <section class="narrative" aria-label={`Popularity history for ${row.name}`}>
        <h2>Popularity, <em>over time</em>.</h2>
        <p>{popularityNarrative}</p>
        {row.peak_count && (
          <p>
            Peak years saw roughly {row.peak_count.toLocaleString()} US births;
            most recent year on record: {(row.births_last_year ?? 0).toLocaleString()}.
          </p>
        )}
      </section>
    )}

    {related.length > 0 && (
      <section class="related" aria-label="Related names">
        <h2>{relatedIntro}</h2>
        <ul class="related-list">
          {related.map((r) => (
            <li>
              <a href={`/names/${nameToSlug(r.name)}`}>
                <span class="related-name">{r.name}</span>
                <span class="related-meta">
                  {r.origin ?? ''}
                  {r.meaning_short ? ` · ${r.meaning_short}` : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="browse" aria-label="Browse more names">
      {row.origin && (
        <a href={`/names/origin/${originSlug(row.origin)}`}>More {row.origin} names →</a>
      )}
      {hasLetterHub && (
        <a href={`/names/starting-with/${initial.toLowerCase()}`}>Names starting with {initial} →</a>
      )}
      <a href="/names/popular">Most popular names →</a>
      <a href="/names">Browse all baby names →</a>
    </nav>

    <aside class="cta" aria-label="Install Namore">
      <h2>Decide <em>together</em>.</h2>
      <p>
        Loving {row.name} is one thing. Both of you loving the same name is
        another. Namore is the private app for couples to swipe through names
        independently and discover the one you both choose.
      </p>
      <div class="cta-buttons">
        <a class="btn btn-ink btn-lg" href={appStoreUrl}>Get the app</a>
        <a class="btn btn-ghost btn-lg" href="https://www.namore.app/">Learn more</a>
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  /* GEO callout — sits above the fold, directly under the hero. Styled as a
     warm bordered card so it reads as a distinct "what this app does" cue
     (for both human visitors and LLM crawlers) rather than blending into the
     factual narrative sections below. */
  .geo-cta {
    margin: 1.5rem 0 2.5rem;
    padding: 1.1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--terra);
    border-radius: 10px;
  }
  .geo-line {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }
  .geo-line strong {
    color: var(--terra-deep);
    font-weight: 600;
  }
  .geo-store {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--terra-deep);
  }
  .geo-store:hover {
    color: var(--ink);
  }
  /* Up-links to the browse hubs. Mono, understated — a navigational footer
     to the name narrative, not a CTA. */
  .browse {
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  .browse a { color: var(--terra-deep); }
  .browse a:hover { color: var(--ink); }
</style>
